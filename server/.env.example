# Neon PostgreSQL Connection URL
# Get this from your Neon Dashboard: https://console.neon.tech
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Port for Express API server
PORT=5000

# Secret key required to access / create / edit / delete drafts from admin UI
ADMIN_SECRET_KEY="adrian-blog-secret-change-me"

# Allowed Frontend Origins (comma separated)
CORS_ORIGIN="http://localhost:5173,https://your-portfolio-domain.vercel.app"
